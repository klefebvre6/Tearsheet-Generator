# HC-Uploader-Public - non-secret environment
# Host: HC-PROD-VPS01   Canonical root: C:\HC
# Authoritative runtime is the NSSM AppEnvironmentExtra block on HC-Uploader-Public.
# This file describes intended non-secret production behavior. NSSM does not load it.
# APP_ENV=sandbox matches live NSSM. The export flags below are the live write mode.
# DOWNSTREAM_INGEST_TOKEN is required, is injected by NSSM, and must not be stored in this file.
# This service does not set GLENN_UPLOADER_INGEST_TOKEN.

APP_ENV=sandbox
SERVE_FRONTEND=true
FRONTEND_STATIC_DIR=C:\HC\apps\uploader\static
DATABASE_PATH=C:\HC\data\uploader\uploader_vps_candidate.db
BENCHMARK_CACHE_DIR=C:\HC\data\uploader\benchmark_cache
BENCHMARK_CACHE_ONLY=false
DOWNSTREAM_SANDBOX_DIR=C:\HC\data\uploader\downstream_sandbox
ROLLBACK_BACKUP_DIR=C:\HC\data\uploader\rollback_backups
EXPORT_DOWNSTREAM_ENABLED=true
EXPORT_DRY_RUN=false
EXPORT_ENABLED=true
EXPORT_TARGET_ENV=production
EXPORT_INCLUDE_YQ=false
EXPORT_ROLLBACK_ENABLED=false
BACKFILL_ENABLED=false
PORT=8091
TKP_INGEST_URL=https://tkp-ts.hcresearch.ltd/api/uploader/ingest-daily-row
TCP_INGEST_URL=https://tcp-ts.hcresearch.ltd/api/uploader/ingest-daily-row
AGM_INGEST_URL=https://agm-ts.hcresearch.ltd/api/uploader/ingest-daily-row
CORS_ALLOW_ORIGINS=http://127.0.0.1:8091,http://localhost:8091,https://uploader.hcresearch.ltd
PYTHONIOENCODING=utf-8
