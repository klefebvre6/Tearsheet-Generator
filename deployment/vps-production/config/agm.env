# HC-AGM-Public - non-secret environment
# Host: HC-PROD-VPS01   Canonical root: C:\HC
# Authoritative runtime is the NSSM AppEnvironmentExtra block on HC-AGM-Public.
# This file describes intended non-secret production behavior. NSSM does not load it.
# GLENN_UPLOADER_INGEST_TOKEN is required. It is injected by NSSM, the key name is also in C:\HC\secrets\agm-ingest.env, and it must not be stored in this file.

HC_APP_ENV=vps-production
HC_AGM_DATA_ROOT=C:\HC\data\agm
HC_AGM_FEE_WORKBOOK=C:\HC\data\agm\Momentum Fee Calculation.xlsx
HC_AGM_MANUAL_STATE_PATH=C:\HC\data\agm\momentum_pacer_manual_daily_rows.json
HC_AGM_PINNED_CSV=C:\HC\data\agm\data\daily_balances\balances_210TGG51_20OCT2025_07JUL2026.csv
HC_AGM_BENCHMARK_CACHE_DIR=C:\HC\data\agm\data\benchmarks
AGM_BENCHMARK_CACHE_ONLY=1
MP_TS_PRODUCTION=1
AGM_BIND_PORT=8304
TEARSHEET_MODE=public
PYTHONPATH=C:\HC\apps\agm
PYTHONIOENCODING=utf-8
GLENN_UPLOADER_INGEST_ENABLED=true
