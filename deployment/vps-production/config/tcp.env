# HC-TCP-Public - non-secret environment
# Host: HC-PROD-VPS01   Canonical root: C:\HC
# NO SECRET VALUES IN THIS FILE.
# Authoritative runtime is the NSSM AppEnvironmentExtra block on HC-TCP-Public.
# This file describes intended non-secret production behavior. NSSM does not load it.
#
# Required secrets are not stored in this file:
#   GLENN_UPLOADER_INGEST_TOKEN is required. The running service is supplied by NSSM only.
#   TCP_V2_ADMIN_TOKEN and TCP_V2_SESSION_SECRET are required.
#   Those two live in C:\HC\secrets\tcp.env, are injected by NSSM, and must not be stored here.

HC_APP_ENV=vps-production

TCP_V2_STATE_MODE=json_active
TCP_V2_BIND_PORT=8302

TCP_V2_STATE_PATH=C:\HC\data\tcp\tcp_daily_returns_secret_state.json
TCP_V2_STATE_BACKUP_PATH=C:\HC\data\tcp\tcp_daily_returns_secret_state.backup.json
TCP_V2_STATE_LOCK_PATH=C:\HC\data\tcp\tcp_daily_returns_secret_state.lock

TCP_V2_BENCHMARK_CACHE_PATH=C:\HC\data\tcp\benchmark\tcp_benchmark_cache.json
TCP_V2_BENCHMARK_BTC_CACHE_PATH=C:\HC\data\tcp\benchmark\tcp_benchmark_btc_cache.json
TCP_V2_BENCHMARK_ETH_CACHE_PATH=C:\HC\data\tcp\benchmark\tcp_benchmark_eth_cache.json

TCP_V2_ALLOW_WORKBOOK_FALLBACK=false
# Benchmark refresh stays enabled. Live NSSM does not set TCP_V2_SKIP_BENCHMARK_FETCH.

TEARSHEET_MODE=public
PYTHONIOENCODING=utf-8
PYTHONPATH=C:\HC\apps\shared;C:\HC\apps\tcp

GLENN_UPLOADER_INGEST_ENABLED=true
