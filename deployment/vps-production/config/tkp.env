# HC-TKP-Public - non-secret environment
# Host: HC-PROD-VPS01   Canonical root: C:\HC
# Authoritative runtime is the NSSM AppEnvironmentExtra block on HC-TKP-Public.
# This file describes intended non-secret production behavior. NSSM does not load it.
# GLENN_UPLOADER_INGEST_TOKEN is required. It is injected by NSSM, the key name is also in C:\HC\secrets\tkp-ingest.env, and it must not be stored in this file.

HC_APP_ENV=vps-production
HC_TKP_STATE_PATH=C:\HC\data\tkp\daily_returns_secret_state.json
HC_TKP_SOURCE_WORKBOOK=C:\HC\data\tkp\tkp_source_workbook.xlsx
TEARSHEET_MODE=public
TKP_BIND_PORT=8301
PYTHONPATH=C:\HC\apps\tkp
PYTHONIOENCODING=utf-8
GLENN_UPLOADER_INGEST_ENABLED=true
